<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#05070A"
    android:padding="8px">

    <!-- Header & Brand Status -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#0A0F1D"
        android:padding="8px">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="SOVEREIGN ELITE TERMINAL"
            android:textColor="#FFD700"
            android:textSize="14sp"
            android:textStyle="bold"
            android:fontFamily="monospace"/>
        <TextView
            android:id="@+id/statusBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" 120 FPS NATIVE "
            android:textColor="#00F6B2"
            android:textSize="10sp"
            android:background="#121A2D"
            android:padding="4px"/>
    </LinearLayout>

    <!-- Multi-Exchange Navigation Dock -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:layout_marginTop="6px">
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:spacing="4px">
            <Button android:id="@+id/btnUnified" android:text="⚡ UNIFIED" android:textColor="#FFD700" android:background="#131B31" android:textSize="10sp" android:layout_width="wrap_content" android:layout_height="36dp"/>
            <Button android:id="@+id/btnBinance" android:text="🟡 BINANCE" android:textColor="#FFD700" android:background="#0A0F1D" android:textSize="10sp" android:layout_width="wrap_content" android:layout_height="36dp"/>
            <Button android:id="@+id/btnBitget" android:text="🔵 BITGET" android:textColor="#FFD700" android:background="#0A0F1D" android:textSize="10sp" android:layout_width="wrap_content" android:layout_height="36dp"/>
            <Button android:id="@+id/btnExness" android:text="🟠 EXNESS" android:textColor="#FFD700" android:background="#0A0F1D" android:textSize="10sp" android:layout_width="wrap_content" android:layout_height="36dp"/>
            <Button android:id="@+id/btnTV" android:text="📈 TRADINGVIEW" android:textColor="#FFD700" android:background="#0A0F1D" android:textSize="10sp" android:layout_width="wrap_content" android:layout_height="36dp"/>
            <Button android:id="@+id/btnQuotex" android:text="🟣 QUOTEX" android:textColor="#FFD700" android:background="#0A0F1D" android:textSize="10sp" android:layout_width="wrap_content" android:layout_height="36dp"/>
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Interactive Gateway Action Rails -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="3"
        android:layout_marginTop="6px">
        <Button
            android:id="@+id/btnDeposit"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:text="DEPOSIT"
            android:textColor="#00F6B2"
            android:background="#064E3B"
            android:textStyle="bold"
            android:textSize="11sp"/>
        <Button
            android:id="@+id/btnExecute"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:text="EXECUTE"
            android:textColor="#38BDF8"
            android:background="#1E3A8A"
            android:textStyle="bold"
            android:textSize="11sp"
            android:layout_marginHorizontal="4px"/>
        <Button
            android:id="@+id/btnWithdraw"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:text="WITHDRAW"
            android:textColor="#F59E0B"
            android:background="#78350F"
            android:textStyle="bold"
            android:textSize="11sp"/>
    </LinearLayout>

    <!-- Multi-Window Grid Matrix -->
    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="2"
        android:layout_marginTop="6px">
        
        <!-- Window 1: Exness Gold -->
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:orientation="vertical" android:background="#0A0F1D" android:padding="8px" android:layout_marginRight="3px">
            <TextView android:text="EXNESS GOLD ($XAU)" android:textColor="#64748B" android:textSize="9sp"/>
            <TextView android:id="@+id/txtGold" android:text="2,675.03" android:textColor="#FFD700" android:textSize="16sp" android:textStyle="bold"/>
            <TextView android:text="+0.58% Bullish" android:textColor="#00F6B2" android:textSize="8sp"/>
        </LinearLayout>

        <!-- Window 2: Binance BTC -->
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:orientation="vertical" android:background="#0A0F1D" android:padding="8px" android:layout_marginLeft="3px">
            <TextView android:text="BINANCE BTC/USDT" android:textColor="#64748B" android:textSize="9sp"/>
            <TextView android:id="@+id/txtBtc" android:text="94,112.43" android:textColor="#FFD700" android:textSize="16sp" android:textStyle="bold"/>
            <TextView android:text="+2.14% Surge" android:textColor="#00F6B2" android:textSize="8sp"/>
        </LinearLayout>
    </GridLayout>

    <!-- AI Master Bot Confluence Box -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#0A0F1D"
        android:padding="8px"
        android:layout_marginTop="6px">
        <TextView android:text="AI MASTER BOT CONFLUENCE CAROUSEL" android:textColor="#00F6B2" android:textSize="10sp" android:textStyle="bold"/>
        <TextView android:text="🏆 EXNESS GOLD (XAU/USD): HIGH-CONFIDENCE LONG" android:textColor="#FFD700" android:textSize="11sp" android:textStyle="bold" android:layout_marginTop="2px"/>
        <TextView android:text="LEV: 10x-20x | SL: 2658.07 | TP: 2714.22" android:textColor="#64748B" android:textSize="9sp" android:layout_marginTop="2px"/>
    </LinearLayout>

    <!-- Live Telemetry Log Window -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:background="#010204"
        android:layout_marginTop="6px"
        android:padding="6px">
        <TextView
            android:id="@+id/txtConsole"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="[00:00.000] Native Multi-Window Quantum Engine Initialized.\n[00:00.045] Binance, Bitget, Exness, Quotex & TradingView bridges locked.\n[READY] Tap action buttons or exchange tabs for live modal execution."
            android:textColor="#00F6B2"
            android:textSize="9sp"
            android:fontFamily="monospace"/>
    </ScrollView>

    <!-- Footer Stamp -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Awais Mintoo & Co. • Quantum Sovereign Suite • Heavyweight Native Edition"
        android:textColor="#64748B"
        android:textSize="8sp"
        android:gravity="center"
        android:layout_marginTop="8px"/>

</LinearLayout>
